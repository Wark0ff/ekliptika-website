# Публичные переменные, которые Next вшивает в сборку. Секретов здесь нет и быть не должно:
# SMTP, пароль админки и CONTENT_DIR живут только на сервере, в /etc/ekliptika/env.
# После правки этого файла артефакт нужно пересобрать.
NEXT_PUBLIC_SITE_URL=https://ekliptika.art
# Индексация закрыта до приёмки сайта заказчиком. Открыть: =1 и пересобрать.
NEXT_PUBLIC_INDEX=
NEXT_PUBLIC_METRIKA_ID=
